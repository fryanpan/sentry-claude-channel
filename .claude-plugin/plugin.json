{
  "name": "sentry-claude-channel",
  "version": "0.2.0",
  "description": "Sentry issue events delivered to subscribed Claude Code sessions as channel notifications",
  "channels": [
    {
      "server": "sentry-claude-channel"
    }
  ],
  "mcpServers": {
    "sentry-claude-channel": {
      "command": "/bin/sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/sentry-channel-mcp.sh",
        "${CLAUDE_PLUGIN_ROOT}/server.ts"
      ]
    }
  }
}
